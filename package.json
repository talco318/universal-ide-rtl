{
  "name": "universal-ide-rtl",
  "displayName": "Universal IDE RTL Support",
  "description": "Enables proper Right-to-Left (RTL & BiDi) text rendering for Hebrew, Arabic & Persian in AI Chat across IDEs (Antigravity, Cursor, Windsurf, Kiro, VS Code, Claude Code) and Git Commits.",
  "publisher": "talco",
  "version": "1.3.9",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "rtl",
    "hebrew",
    "arabic",
    "right-to-left",
    "bidi",
    "bidirectional",
    "claude-code",
    "claude",
    "claude-code-rtl",
    "ivrit",
    "arabi",
    "farsi",
    "persian",
    "hebrew-rtl",
    "arabic-rtl",
    "cursor",
    "cursor-ai",
    "windsurf",
    "antigravity",
    "kiro",
    "ai-chat",
    "copilot",
    "chat",
    "git-commit",
    "source-control",
    "markdown-rtl",
    "vscode"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/talco318/universal-ide-rtl.git"
  },
  "bugs": {
    "url": "https://github.com/talco318/universal-ide-rtl/issues"
  },
  "homepage": "https://github.com/talco318/universal-ide-rtl#readme",
  "scripts": {
    "growth:stats": "node scripts/track-growth.js",
    "package": "npx @vscode/vsce package --allow-star-activation",
    "release": "node create-release.js"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/markdown-rtl.css"
    ],
    "commands": [
      {
        "command": "universal-rtl.toggle",
        "title": "RTL: Toggle Status",
        "category": "Universal RTL"
      },
      {
        "command": "universal-rtl.toggleEditorRtl",
        "title": "RTL: Toggle Editor/Preview RTL",
        "category": "Universal RTL",
        "icon": {
          "light": "media/align-right-light.svg",
          "dark": "media/align-right-dark.svg"
        }
      },
      {
        "command": "universal-rtl.clearAllEditorRtl",
        "title": "RTL: Clear All RTL Editor/Preview Files",
        "category": "Universal RTL"
      },
      {
        "command": "universal-rtl.fixChecksums",
        "title": "RTL: Fix IDE Checksums",
        "category": "Universal RTL"
      },
      {
        "command": "universal-rtl.openReview",
        "title": "RTL: Rate & Review on Open VSX (5 Stars)",
        "category": "Universal RTL"
      },
      {
        "command": "universal-rtl.share",
        "title": "RTL: Share Universal IDE RTL Extension",
        "category": "Universal RTL"
      },
      {
        "command": "universal-rtl.patchClaudeCode",
        "title": "RTL: Patch Claude Code Extension",
        "category": "Universal RTL"
      },
      {
        "command": "universal-rtl.unpatchClaudeCode",
        "title": "RTL: Unpatch Claude Code Extension",
        "category": "Universal RTL"
      },
      {
        "command": "universal-rtl.checkClaudeCodeStatus",
        "title": "RTL: Check Claude Code RTL Status",
        "category": "Universal RTL"
      }
    ],
    "keybindings": [
      {
        "command": "universal-rtl.toggle",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "universal-rtl.toggleEditorRtl",
          "group": "navigation",
          "when": "editorLangId == markdown || activeEditor == 'vscode.markdown.preview.editor'"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "16.x"
  }
}

